# Supabase Postgres connection string (Transaction pooler, port 6543).
# Get it from: Supabase Dashboard -> Connect -> Transaction pooler.
# The app connects with the dedicated `oea_app` role.
DATABASE_URL="postgresql://oea_app.<project-ref>:<password>@<pooler-host>:6543/postgres"

# SerpApi key for the Auto-Scan engine (free tier: serpapi.com).
# Without it, scans are skipped (the rest of the site works normally).
SERPAPI_KEY=""

# Optional: override the auto-scan search queries (comma separated).
# SCAN_QUERIES="Events in Bhubaneswar Odisha,Events in Cuttack Odisha,Upcoming events in Odisha"

# --- Social hashtag scanning (Instagram/Facebook — clubs, DJ nights, events) ---
# Meta forbids open hashtag scraping; use ONE of the two sanctioned routes below.
# If neither is set, the social scan is skipped (the rest of the site is fine).
#
# Route 1 — Official Instagram Graph API (free). Requires a Meta developer app,
# an Instagram Business/Creator account linked to a Facebook Page, the
# instagram_basic + instagram_manage_insights permissions, and a long-lived token.
# IG_USER_ID is that connected Instagram Business account's numeric ID.
IG_GRAPH_TOKEN=""
IG_USER_ID=""
#
# Route 2 — Third-party scraper via Apify (apidojo/instagram-scraper, pay-per-result).
# One run covers hashtags AND pages; every post also feeds the frequent-source logger
# (SourceSignal table) so recurring venue/promoter handles surface for promotion.
# ROTATE any previously exposed token before using it here, then paste the new one.
APIFY_TOKEN=""
#
# Optional: override the hashtags scanned (comma separated, # optional).
# Keep it small (~<30) for the IG Graph route — it allows ~30 unique hashtags/7 days.
# The Apify route has no such cap; the wider set below is tuned for it.
# SCAN_HASHTAGS="bhubaneswarnightlife,bhubaneswarparty,djnightbhubaneswar,bhubaneswarclub,odishaparty,partybhubaneswar,bhubaneswarpub,bhubaneswarevents,odishaevents,eventsinbhubaneswar,bbsrevents,bhubaneswardiaries,bhubaneswarfoodie,bhubaneswarcafe,bhubaneswarconcert,bhubaneswarlivemusic,bhubaneswarmusic,bhubaneswarcomedy,odishafestival,exploreodisha,cuttackevents,cuttacknightlife,cuttackdiaries,rourkelaevents,purievents"
#
# Apify-only: known public pages to pull directly (comma separated, @ optional).
# Verify each is public and actually posts events — an unknown handle just burns a query.
# SCAN_PAGES="mybhubaneswar,club1,restaurant1,promoter1,dj1"
#
# Apify-only tuning. Keep RESULTS_LIMIT <= the actor's free-posts-per-query so per-post
# cost stays ~$0; NEWER_THAN_DAYS skips paying to re-pull stale posts (confirm the actor's
# field name on its Input tab before relying on it).
# APIFY_RESULTS_LIMIT="8"
# APIFY_NEWER_THAN_DAYS="3"
# APIFY_ACTOR="apidojo~instagram-scraper"   # override only to switch actors

# Protects /api/cron/auto-scan; Vercel sends it automatically for cron jobs.
CRON_SECRET=""

# Secret for signing admin session JWTs.
JWT_SECRET=""
